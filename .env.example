# App
APP_ENV=development
APP_NAME=LingoPika
SECRET_KEY=change-me-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://lingopika:lingopika@db:5432/lingopika
SYNC_DATABASE_URL=postgresql+psycopg2://lingopika:lingopika@db:5432/lingopika

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

# Premium (Telegram Stars)
STARS_PROVIDER_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:5173,https://web.telegram.org

# Hearts
HEART_MAX=5
HEART_REGEN_HOURS=4

# Leagues
LEAGUE_SEASON_DAYS=7
